{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main Veil window: talk to the engine through the app's own commands and receive engine events. No file, shell or network access from the web view.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-status",
    "allow-get-policy",
    "allow-set-policy",
    "allow-pause",
    "allow-resume",
    "allow-activity",
    "allow-clear-activity",
    "allow-model-status",
    "allow-download-model",
    "allow-cancel-download",
    "allow-remove-model",
    "allow-permissions",
    "allow-request-permission",
    "allow-engine-restart",
    "allow-app-state",
    "allow-complete-setup",
    "allow-set-autostart",
    "allow-open-link",
    "allow-check-for-update"
  ]
}
